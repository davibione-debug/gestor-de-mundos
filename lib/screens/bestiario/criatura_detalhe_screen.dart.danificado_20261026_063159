  Future<List<String>> _buscarLocalizacoes() async {
    final locaisEncontrados = <String>{};
    final personagensEncontrados = <String>{};
    final eventosEncontrados = <String>{};
    final pontosEncontrados = <String>{};

    final locais = await LocaisRepository().carregar();
    final personagens = await NPCsRepository().carregar();

    void verificarPersonagensDoGrupo(dynamic grupo) {
      if (grupo == null) return;

      for (final periodo in [
        grupo.diurno,
        grupo.noturno,
        grupo.pesca,
        grupo.surfe,
      ]) {
        if (periodo is! Iterable) continue;

        for (final encontro in periodo) {
          try {
            final npc = encontro.npc;
            if (_verificarPersonagem(npc)) {
              final nome = _nomeRegistro(npc, '').trim();
              if (nome.isNotEmpty) personagensEncontrados.add(nome);
            }
          } catch (_) {}
        }
      }
    }

    for (final local in locais) {
      final nomeLocal = _nomeRegistro(local, '').trim();

      if (nomeLocal.isNotEmpty && _verificarGrupoEncontros(local.encontros)) {
        locaisEncontrados.add(nomeLocal);
      }

      verificarPersonagensDoGrupo(local.treinadores);
      verificarPersonagensDoGrupo(local.rockets);

      for (final evento in local.eventos) {
        if (_referenciaEstaCriatura(evento.criatura)) {
          final nome = _nomeRegistro(evento, '').trim();
          if (nome.isNotEmpty) eventosEncontrados.add(nome);
        }
      }

      for (final ponto in local.pontosInteresse) {
        final nomePonto = _nomeRegistro(ponto, '').trim();
        var referenciaDireta = false;

        try {
          referenciaDireta = ponto.criaturas.any(_referenciaEstaCriatura);
        } catch (_) {}

        if (!referenciaDireta) {
          referenciaDireta = _verificarGrupoEncontros(ponto.encontros);
        }

        if (referenciaDireta && nomePonto.isNotEmpty) {
          pontosEncontrados.add(nomePonto);
        }

        for (final evento in ponto.eventos) {
          if (_referenciaEstaCriatura(evento.criatura)) {
            final nome = _nomeRegistro(evento, '').trim();
            if (nome.isNotEmpty) eventosEncontrados.add(nome);
          }
        }

        for (final npc in ponto.npcs) {
          if (_verificarPersonagem(npc)) {
            final nome = _nomeRegistro(npc, '').trim();
            if (nome.isNotEmpty) personagensEncontrados.add(nome);
          }
        }
      }
    }

    for (final personagem in personagens) {
      if (_verificarPersonagem(personagem)) {
        final nome = _nomeRegistro(personagem, '').trim();
        if (nome.isNotEmpty) personagensEncontrados.add(nome);
      }
    }

    final resultados = <String>[];

    void adicionarGrupo(String tipo, Set<String> nomes) {
      final ordenados = nomes.toList()..sort();
      if (ordenados.isNotEmpty) {
        resultados.add('$tipo: ${ordenados.join(', ')}');
      }
    }

    adicionarGrupo('Local', locaisEncontrados);
    adicionarGrupo('Personagem', personagensEncontrados);

    return resultados;
  }

  Widget _secaoLocalizacao() {
    return FutureBuilder<List<String>>(
      future: _localizacoesFuture,
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Card(
            child: Padding(
              padding: EdgeInsets.all(16),
              child: Center(child: CircularProgressIndicator()),
            ),
          );
        }

        if (snapshot.hasError) {
          return Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Text(
                'Não foi possível carregar as localizações: ${snapshot.error}',
              ),
            ),
          );
        }

        final localizacoes = snapshot.data ?? [];

        return Card(
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'LOCALIZAÇÃO',
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 12),
                if (localizacoes.isEmpty)
                  const Text('Nenhum registro referencia esta criatura.')
                else
                  for (final localizacao in localizacoes)
                    Padding(
                      padding: const EdgeInsets.only(bottom: 8),
                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Icon(
                            Icons.location_on_outlined,
                            size: 20,
                          ),
                          const SizedBox(width: 8),
                          Expanded(child: Text(localizacao)),
                        ],
                      ),
                    ),
              ],
            ),
          ),
        );
      },
    );
  }

  @override
  @override
  Widget build(BuildContext context) {
    final batalhas = ref.watch(batalhasProvider);

    Batalhacriatura? batalha;

    if (_batalhaId != null) {
      for (final item in batalhas) {
        if (item.id == _batalhaId) {
          batalha = item;
          break;
        }
      }
    }

    final criaturaExibido = batalha?.criatura ?? _criatura;

    final batalhaAberta = batalha != null;

    return Scaffold(
      appBar: AppBar(
        title: Text(criaturaExibido.nome),
        actions: [
          if (widget.onDelete != null)
            IconButton(
              tooltip: 'Excluir Criatura',
              icon: const Icon(
                Icons.delete_outline,
              ),
              onPressed: _excluir,
            ),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.fromLTRB(
          14,
          14,
          14,
          24,
        ),
        children: [
          CriaturaCard(
            criatura: criaturaExibido,
            batalhaAberta: batalhaAberta,
            onBatalha: _abrirBatalha,
            nivelAlteravel: widget.nivelAlteravel && !batalhaAberta,
            onNivelChanged:
                widget.nivelAlteravel && !batalhaAberta ? _alterarNivel : null,
          ),
          _secaoLocalizacao(),
          if (batalha != null) _painelBatalha(batalha),
        ],
      ),
    );
  }
}
