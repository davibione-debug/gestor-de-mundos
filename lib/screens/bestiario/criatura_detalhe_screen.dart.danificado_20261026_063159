  bool _referenciaEstaCriatura(dynamic referencia) {
    final nomeId = _criatura.nome.trim();

    if (referencia == null) return false;

    if (referencia is String) {
      return referencia.trim() == nomeId;
    }

    try {
      final nome = referencia.nome?.toString().trim() ?? '';
      if (nome == nomeId) return true;
    } catch (_) {}

    try {
      final id = referencia.id?.toString().trim() ?? '';
      if (id == nomeId) return true;
    } catch (_) {}

    return false;
  }

  String _nomeRegistro(dynamic registro, [String fallback = 'Registro']) {
    try {
      final nome = registro.nome?.toString().trim() ?? '';
      if (nome.isNotEmpty) return nome;
    } catch (_) {}

    return fallback;
  }

  }

  bool _verificarGrupoEncontros(dynamic grupo) {
    if (grupo == null) return false;

    try {
      for (final periodo in [
        grupo.diurno,
        grupo.noturno,
        grupo.pesca,
        grupo.surfe,
      ]) {
        if (periodo is Iterable) {
          for (final encontro in periodo) {
            try {
              if (_referenciaEstaCriatura(encontro.criatura)) {
                return true;
              }
            } catch (_) {}
          }
        }
      }
    } catch (_) {}

    return false;
  }

  bool _verificarPersonagem(dynamic personagem) {
    if (personagem == null) return false;

    try {
      final criaturas = personagem.criaturas;
      if (criaturas is Iterable && criaturas.any(_referenciaEstaCriatura)) {
        return true;
      }
    } catch (_) {}

    try {
      final fichas = personagem.fichasCriatura;
      if (fichas is Iterable && fichas.any(_referenciaEstaCriatura)) {
        return true;
      }
    } catch (_) {}

    return false;
